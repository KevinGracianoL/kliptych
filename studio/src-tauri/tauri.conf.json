{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kliptych Studio",
  "version": "0.1.0",
  "identifier": "com.kliptych.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kliptych Studio",
        "width": 1440,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Editor local de clips verticales con IA",
    "longDescription": "Kliptych Studio permite componer historias en formato vertical 9:16 con ingesta directa de URL, subtítulos con tipografía OFL empaquetada, scrubbing en tiempo real y exportación final con evaluación de conformidad fail-closed.",
    "copyright": "Copyright 2026 Kevin Graciano",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1",
          "librsvg2-2"
        ]
      }
    }
  }
}
